# ---- Required -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Model selection ------------------------------------------------------
# Big model: planning, action selection, verification reasoning.
PRAXIS_MODEL=gemini-2.5-flash
# Cheap model: observation summarisation and fact extraction.
PRAXIS_MODEL_FAST=gemini-2.5-flash-lite

# ---- Runtime --------------------------------------------------------------
# Where the sandbox apps and the agent API live.
PRAXIS_BASE_URL=http://localhost:3000
# Show the browser while the agent drives it. Great for demos, slower in eval.
PRAXIS_HEADLESS=false
# Hard ceiling on tool calls per step and per run, so a confused agent
# cannot spin forever.
PRAXIS_MAX_STEP_ATTEMPTS=4
PRAXIS_MAX_RUN_ACTIONS=80

# ---- Sandbox credentials (fake, local only) -------------------------------
# These are seeded into the local SQLite sandbox. Not real credentials.
SANDBOX_PORTAL_USER=ap.clerk@northwind.example
SANDBOX_PORTAL_PASSWORD=hunter2-sandbox
# Probability that the vendor portal invoice API returns a 500, used to
# prove the retry path works. 0 disables fault injection.
SANDBOX_FAULT_RATE=0.25
