# ---- Required -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Model routing --------------------------------------------------------
# Calls are routed by stakes against frequency, and paced to stay inside the
# per-minute quota. Measured on the free tier: flagship flash models allow
# 5 requests/min, lite models 15. A task makes roughly 40 model calls, so
# running everything on the flagship means minutes of pure waiting.
#
# Planning, judging a step and verifying the result: few calls, expensive to
# get wrong.
PRAXIS_MODEL_REASONING=gemini-3.8-flash
PRAXIS_RPM_REASONING=5
# Choosing the next action: fires every turn, tightly constrained by the prompt.
PRAXIS_MODEL_ACTION=gemini-3.5-flash-lite
PRAXIS_RPM_ACTION=15
# Mechanical summarising.
PRAXIS_MODEL_FAST=gemini-3.5-flash-lite
PRAXIS_RPM_FAST=15

# ---- Runtime --------------------------------------------------------------
# Where the sandbox apps and the agent API live.
PRAXIS_BASE_URL=http://localhost:3000
# Show the browser while the agent drives it. Great for demos, slower in eval.
PRAXIS_HEADLESS=false
# Hard ceiling on tool calls per step and per run, so a confused agent
# cannot spin forever.
PRAXIS_MAX_STEP_ATTEMPTS=4
PRAXIS_MAX_RUN_ACTIONS=80

# ---- Sandbox credentials (fake, local only) -------------------------------
# These are seeded into the local SQLite sandbox. Not real credentials.
SANDBOX_PORTAL_USER=ap.clerk@northwind.example
SANDBOX_PORTAL_PASSWORD=hunter2-sandbox
# Probability that the vendor portal invoice API returns a 500, used to
# prove the retry path works. 0 disables fault injection.
SANDBOX_FAULT_RATE=0.25
